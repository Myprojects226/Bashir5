{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, customer type, and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "inventory_manager", "orders_manager", "delivery_manager", "customer"] },
        "customerType": { "type": "string", "enum": ["retail", "wholesale", "commercial"] },
        "companyName": { "type": "string", "maxLength": 150 },
        "taxNumber": { "type": "string", "maxLength": 50 },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "phone", "role", "customerType", "isVerified", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Plastic and detergent product catalogue item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 64 },
        "nameAr": { "type": "string", "maxLength": 200 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "price": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "sku", "nameAr", "categoryId", "price", "stockQuantity", "unit", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order for retail or wholesale supplies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 30 },
        "subtotal": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["new", "pending", "confirmed", "processing", "out_for_delivery", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["cod", "bank_transfer", "card", "apple_pay", "stc_pay", "kuraimi", "e_wallet"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "deliveryMethod": { "type": "string", "enum": ["home_delivery", "store_pickup", "express_delivery"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "orderNumber", "userId", "userName", "userPhone", "subtotal", "totalAmount", "status", "paymentMethod", "deliveryMethod", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Product rating and feedback by customer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "isApproved": { "type": "boolean" }
      },
      "required": ["id", "productId", "productName", "userId", "userName", "rating", "comment", "createdAt", "isApproved"]
    },
    "WholesaleRequest": {
      "title": "WholesaleRequest",
      "description": "Commercial supply quote and bulk inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "facilityName": { "type": "string", "maxLength": 150 },
        "contactName": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "activityType": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "monthlyCartons": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "contacted", "approved", "rejected"] }
      },
      "required": ["id", "facilityName", "contactName", "contactPhone", "activityType", "city", "createdAt", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inquiry or message sent through the contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["unread", "read", "responded"] }
      },
      "required": ["id", "name", "phone", "subject", "message", "createdAt", "status"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor or manufacturing supplier profile and credit balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "companyName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 255 },
        "paymentTerms": { "type": "string", "enum": ["cash", "credit_15", "credit_30", "credit_60", "consignment", "custom"] },
        "balance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalPaid": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "companyName", "phone", "city", "address", "paymentTerms", "balance", "totalPurchases", "totalPaid", "isActive", "createdAt"]
    },
    "AccountingTransaction": {
      "title": "AccountingTransaction",
      "description": "Accounting journal vouchers, receipts, payments, and expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entryNumber": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["receipt_voucher", "payment_voucher", "journal_entry", "purchase_invoice", "sales_invoice", "sales_return", "operating_expense"] },
        "date": { "type": "string", "maxLength": 30 },
        "amount": { "type": "number" },
        "accountFrom": { "type": "string", "maxLength": 100 },
        "accountTo": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "paymentMethod": { "type": "string", "enum": ["cod", "bank_transfer", "card", "apple_pay", "stc_pay", "kuraimi", "e_wallet"] },
        "status": { "type": "string", "enum": ["confirmed", "draft", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "entryNumber", "type", "date", "amount", "accountFrom", "accountTo", "category", "description", "paymentMethod", "status", "createdAt", "createdBy"]
    },
    "PurchaseInvoice": {
      "title": "PurchaseInvoice",
      "description": "Wholesale purchase invoice from supplier with packaging units and costs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "partial", "unpaid"] },
        "paymentMethod": { "type": "string", "enum": ["cod", "bank_transfer", "card", "apple_pay", "stc_pay", "kuraimi", "e_wallet"] },
        "status": { "type": "string", "enum": ["received", "pending", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoiceNumber", "supplierId", "supplierName", "date", "subtotal", "totalAmount", "paidAmount", "remainingAmount", "paymentStatus", "paymentMethod", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles and roles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Stores store products and stock"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores customer and wholesale orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Stores customer reviews for products"
    },
    "/wholesale_requests/{requestId}": {
      "schema": "WholesaleRequest",
      "description": "Stores B2B wholesale supply requests"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Stores messages submitted to Taiz warehouse"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Stores manufacturing and trade suppliers"
    },
    "/accounting_transactions/{transactionId}": {
      "schema": "AccountingTransaction",
      "description": "Stores accounting journal entries, vouchers, and expenses"
    },
    "/purchase_invoices/{invoiceId}": {
      "schema": "PurchaseInvoice",
      "description": "Stores purchase invoices from vendors"
    }
  }
}
